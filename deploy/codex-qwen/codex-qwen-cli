#!/usr/bin/env bash
set -euo pipefail

CATALOG="${QWEN_MODELS_JSON:-$HOME/.codex/qwen-models.json}"

exec /usr/bin/codex \
  -c 'model="qwen3.8-max"' \
  -c 'model_provider="codex_local_access"' \
  -c 'model_context_window=131072' \
  -c 'model_auto_compact_token_limit=98304' \
  -c "model_catalog_json=\"${CATALOG}\"" \
  -c 'model_providers.codex_local_access={name="FreeQwenApi",base_url="http://127.0.0.1:3270/v1",wire_api="responses",experimental_bearer_token="local-ssh-tunnel",request_max_retries=2,stream_max_retries=2,stream_idle_timeout_ms=300000}' \
  "$@"
